---
import Layout from "../layouts/Layout.astro";
import { tEn } from "../lib/strings";
---

<Layout title={tEn("homeSeoTitle")} description={tEn("homeDescription")}>
  <h1 class="mb-1 text-3xl font-bold">{tEn("siteName")}</h1>
  <p class="max-w-xl text-neutral-400">{tEn("tagline")}</p>
  <div class="mt-6 grid gap-4 sm:grid-cols-2">
    <a href="/funding-rates" class="rounded-lg border border-neutral-800 p-5 no-underline hover:border-neutral-500">
      <h2 class="mb-2 text-lg font-semibold text-neutral-50">{tEn("navFundingRates")}</h2>
      <p class="text-sm text-neutral-400">Perp funding across the tracked universe, sortable by APR.</p>
    </a>
    <a href="/fees" class="rounded-lg border border-neutral-800 p-5 no-underline hover:border-neutral-500">
      <h2 class="mb-2 text-lg font-semibold text-neutral-50">{tEn("navFees")}</h2>
      <p class="text-sm text-neutral-400">What your monthly volume costs per exchange.</p>
    </a>
  </div>
</Layout>
