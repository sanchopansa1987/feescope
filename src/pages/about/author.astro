---
import Layout from "../../layouts/Layout.astro";
import { author } from "../../config/author";
import { tEn } from "../../lib/strings";

const personSchema = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: author.name,
  jobTitle: author.role,
  description:
    "Operations and compliance professional with experience at ACX (Australian Crypto Exchange) and Huobi Australia. Part of the team behind one of the first arbitrage crypto trading bots.",
  url: "/about/author",
  knowsAbout: [
    "cryptocurrency exchanges",
    "crypto compliance",
    "perpetual futures",
    "funding rates",
    "arbitrage trading",
  ],
  worksFor: { "@type": "Organization", name: "FeeScope" },
};
---

<Layout title={`${author.name} — FeeScope`} description={`${author.name} — operational and compliance professional, founder of FeeScope.`}>
  <script type="application/ld+json" set:html={JSON.stringify(personSchema)} />

  <article class="mx-auto max-w-[700px] space-y-8 text-neutral-200">
    <nav class="text-sm text-neutral-400" aria-label="Breadcrumb">
      <a href="/" class="no-underline hover:text-neutral-100">{tEn("siteName")}</a>
      <span class="mx-2">/</span>
      <a href="/about" class="no-underline hover:text-neutral-100">{tEn("navAbout")}</a>
      <span class="mx-2">/</span>
      <span class="text-neutral-200">{author.name}</span>
    </nav>

    <h1 class="text-3xl font-bold text-neutral-50">{author.name}</h1>
    <p class="text-neutral-400">{author.role}</p>

    <!-- Photo placeholder — replace with <img src="/images/author.jpg" alt={author.name} /> once the portrait is supplied -->
    <div class="flex h-24 w-24 items-center justify-center rounded-full border border-neutral-700 bg-neutral-800">
      <svg width="40" height="40" viewBox="0 0 24 24" fill="currentColor" class="text-neutral-500" aria-hidden="true">
        <circle cx="12" cy="8" r="4" />
        <path d="M4 20c0-4 4-6 8-6s8 2 8 6v1H4z" />
      </svg>
    </div>

    <section class="space-y-4 text-neutral-300">
      <p>{tEn("authorBio1")}</p>
      <p>{tEn("authorBio2")}</p>
      <p>{tEn("authorBio3")}</p>
    </section>

    <section class="space-y-3">
      <h2 class="text-xl font-semibold text-neutral-50">{tEn("authorWhyHeading")}</h2>
      <p class="text-neutral-300">{tEn("authorWhy1")}</p>
      <p class="text-neutral-300">{tEn("authorWhy2")}</p>
    </section>

    <section class="space-y-3">
      <h2 class="text-xl font-semibold text-neutral-50">{tEn("authorIsIsntHeading")}</h2>
      <p class="font-medium text-neutral-100">{tEn("authorIsLabel")}</p>
      <ul class="list-disc space-y-1 pl-6 text-neutral-300">
        <li>{tEn("authorIs1")}</li>
        <li>{tEn("authorIs3")}</li>
      </ul>
      <p class="font-medium text-neutral-100">{tEn("authorIsntLabel")}</p>
      <ul class="list-disc space-y-1 pl-6 text-neutral-300">
        <li>{tEn("authorIsnt1")}</li>
        <li>{tEn("authorIsnt2")}</li>
        <li>{tEn("authorIsnt3")}</li>
        <li>{tEn("authorIsnt4")}</li>
      </ul>
    </section>

    <section class="space-y-3">
      <h2 class="text-xl font-semibold text-neutral-50">{tEn("authorAiHeading")}</h2>
      <p class="text-neutral-300">{tEn("authorAiBody")}</p>
    </section>

    <section class="space-y-3">
      <h2 class="text-xl font-semibold text-neutral-50">{tEn("authorAffiliateHeading")}</h2>
      <p class="text-neutral-300">{tEn("authorAffiliateBody")}</p>
    </section>

    <section class="space-y-3">
      <h2 class="text-xl font-semibold text-neutral-50">{tEn("authorContactHeading")}</h2>
      <p class="text-neutral-300">
        {tEn("authorContactBody")} <a href={`mailto:${author.contact}`} class="text-neutral-100 underline">{author.contact}</a>
      </p>
    </section>
  </article>
</Layout>
